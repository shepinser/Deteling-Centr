    <Compile Update="Form2.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Form4.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Form3.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Form5.cs"><SubType>Form</SubType></Compile>
  </ItemGroup>

</Project>
